## 验证 openspec/specs/continuous-chunk-world 与 world-script-boundaries 的区块加载、回环及测试布置场景。
class_name TestChunkWorld
extends SceneTree


## 运行区块世界行为断言并退出。
func _initialize() -> void:
	var cache := LocalDataRepoCache.new()
	var temp_path := "user://tests/chunk_work_%d.json" % Time.get_ticks_usec()
	var working_store := WorkingSaveStore.new({}, temp_path)
	cache.bind_working_store(working_store)
	var source: WorldManager = WorldManager.Create(cache)
	var cfg := ManualChunkCfg.new()
	WorldEcsTestAccess.InitializeTestChunks(source, cfg)
	var player_id := WorldEcsTestAccess.CreatePlayer(source, Vector2(1, 1), 3.0)
	source.step(0.0)
	assert(source.chunks_view().active_count() <= 9)
	var initial_loaded: Array[Vector2i] = source.chunks_view().loaded
	assert(initial_loaded.size() == 9)
	assert(initial_loaded.has(Vector2i(0, 0)))
	var before := source.tile_type(Vector2i(1, 1))
	source.send_event(ToggleTileEvent.Create(Vector2(1, 1)))
	assert(source.tile_type(Vector2i(1, 1)) == 1 - before)
	WorldEcsTestAccess.SetPlayerPosition(source, player_id, Vector2(25, 25))
	source.step(0.0)
	var distant_loaded: Array[Vector2i] = source.chunks_view().loaded
	assert(distant_loaded.size() == 9)
	assert(not distant_loaded.has(Vector2i(0, 0)))
	assert(not source.chunks_view().has_chunk(Vector2i(0, 0)))
	WorldEcsTestAccess.SetPlayerPosition(source, player_id, Vector2(1, 1))
	source.step(0.0)
	assert(source.tile_type(Vector2i(1, 1)) == 1 - before)
	assert(source.tile_type(Vector2i(49, 1)) == 1 - before)
	assert(source.tile_type(Vector2i(1, -47)) == 1 - before)
	WorldEcsTestAccess.SetPlayerPosition(source, player_id, Vector2(11.9, 1.0))
	source.step(0.0)
	source.send_event(MoveIntentEvent.Create(player_id, Vector2i.RIGHT))
	source.step(1.0)
	assert(source.chunks_view().loaded.has(Vector2i(2, 0)))
	assert(not source.chunks_view().loaded.has(Vector2i(-1, 0)))
	var compact_cache := LocalDataRepoCache.new()
	var compact_path := "user://tests/chunk_compact_%d.json" % Time.get_ticks_usec()
	compact_cache.bind_working_store(WorkingSaveStore.new({}, compact_path))
	var compact_world := WorldManager.Create(compact_cache)
	WorldEcsTestAccess.CreatePlayer(compact_world, Vector2.ZERO, 3.0)
	var compact_cfg := ManualChunkCfg.new()
	compact_cfg.active_chunk_size = Vector2i.ONE
	WorldEcsTestAccess.InitializeTestChunks(compact_world, compact_cfg)
	assert(compact_world.chunks_view().loaded.size() == 1)
	assert(compact_world.chunks_view().active_count() == 1)
	var wrap_cache := LocalDataRepoCache.new()
	var wrap_path := "user://tests/chunk_wrap_%d.json" % Time.get_ticks_usec()
	wrap_cache.bind_working_store(WorkingSaveStore.new({}, wrap_path))
	var wrap_world := WorldManager.Create(wrap_cache)
	var wrap_player_id: int = WorldEcsTestAccess.CreatePlayer(wrap_world, Vector2.ZERO, 3.0)
	var wrap_cfg := ManualChunkCfg.new()
	wrap_cfg.active_chunk_size = Vector2i(5, 5)
	WorldEcsTestAccess.InitializeTestChunks(wrap_world, wrap_cfg)
	assert(wrap_world.chunks_view().loaded.size() == 25)
	assert(wrap_world.chunks_view().active_count() == 16)
	assert(wrap_world.chunk_entity(Vector2i.ZERO) == wrap_world.chunk_entity(Vector2i(4, 0)))
	WorldEcsTestAccess.SetPlayerPosition(wrap_world, wrap_player_id, Vector2(25, 25))
	wrap_world.step(0.0)
	assert(wrap_world.chunks_view().active_count() == 16)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(temp_path))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(compact_path))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(wrap_path))
	print("test_chunk_world passed")
	quit()
