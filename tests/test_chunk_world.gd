## 验证 openspec/specs/continuous-chunk-world/spec.md 的区块加载、回环与改动保留场景。
class_name TestChunkWorld
extends SceneTree


## 运行区块世界行为断言并退出。
func _initialize() -> void:
	var cache := LocalDataRepoCache.new()
	var temp_path := "user://tests/chunk_work_%d.json" % Time.get_ticks_usec()
	var working_store := WorkingSaveStore.new({}, temp_path)
	cache.bind_working_store(working_store)
	var source: WorldState = WorldState.Create(cache)
	var cfg := ManualChunkCfg.new()
	source.initialize_test_chunks(cfg)
	var player_id := source.create_player(Vector2(1, 1), 3.0)
	source.step(0.0)
	assert(source.chunks().active_count() <= 9)
	var initial_loaded: Array[Vector2i] = source.chunks().loaded
	assert(initial_loaded.size() == 9)
	assert(initial_loaded.has(Vector2i(0, 0)))
	var before := source.tile_type(Vector2i(1, 1))
	source.toggle_tile(Vector2(1, 1))
	assert(source.tile_type(Vector2i(1, 1)) == 1 - before)
	source.set_player_position(player_id, Vector2(25, 25))
	source.step(0.0)
	var distant_loaded: Array[Vector2i] = source.chunks().loaded
	assert(distant_loaded.size() == 9)
	assert(not distant_loaded.has(Vector2i(0, 0)))
	assert(not source.chunks().has_chunk(Vector2i(0, 0)))
	source.set_player_position(player_id, Vector2(1, 1))
	source.step(0.0)
	assert(source.tile_type(Vector2i(1, 1)) == 1 - before)
	assert(source.tile_type(Vector2i(49, 1)) == 1 - before)
	assert(source.tile_type(Vector2i(1, -47)) == 1 - before)
	source.set_player_position(player_id, Vector2(11.9, 1.0))
	source.step(0.0)
	source.set_player_intent(player_id, Vector2i.RIGHT)
	source.step(1.0)
	assert(source.chunks().loaded.has(Vector2i(2, 0)))
	assert(not source.chunks().loaded.has(Vector2i(-1, 0)))
	var compact_cache := LocalDataRepoCache.new()
	var compact_path := "user://tests/chunk_compact_%d.json" % Time.get_ticks_usec()
	compact_cache.bind_working_store(WorkingSaveStore.new({}, compact_path))
	var compact_world := WorldState.Create(compact_cache)
	compact_world.create_player(Vector2.ZERO, 3.0)
	var compact_cfg := ManualChunkCfg.new()
	compact_cfg.active_chunk_size = Vector2i.ONE
	compact_world.initialize_test_chunks(compact_cfg)
	assert(compact_world.chunks().loaded.size() == 1)
	assert(compact_world.chunks().active_count() == 1)
	var wrap_cache := LocalDataRepoCache.new()
	var wrap_path := "user://tests/chunk_wrap_%d.json" % Time.get_ticks_usec()
	wrap_cache.bind_working_store(WorkingSaveStore.new({}, wrap_path))
	var wrap_world := WorldState.Create(wrap_cache)
	var wrap_player_id: int = wrap_world.create_player(Vector2.ZERO, 3.0)
	var wrap_cfg := ManualChunkCfg.new()
	wrap_cfg.active_chunk_size = Vector2i(5, 5)
	wrap_world.initialize_test_chunks(wrap_cfg)
	assert(wrap_world.chunks().loaded.size() == 25)
	assert(wrap_world.chunks().active_count() == 16)
	assert(wrap_world.chunk_entity(Vector2i.ZERO) == wrap_world.chunk_entity(Vector2i(4, 0)))
	wrap_world.set_player_position(wrap_player_id, Vector2(25, 25))
	wrap_world.step(0.0)
	assert(wrap_world.chunks().active_count() == 16)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(temp_path))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(compact_path))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(wrap_path))
	print("test_chunk_world passed")
	quit()
