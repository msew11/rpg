{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "title": "Client map configuration",
    "type": "object",
    "required": [
      "id",
      "width",
      "height",
      "tileSize",
      "defaultTile",
      "overrides",
      "chunkSizeTiles"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      },
      "width": {
        "type": "integer",
        "minimum": 1
      },
      "height": {
        "type": "integer",
        "minimum": 1
      },
      "tileSize": {
        "type": "integer",
        "minimum": 1
      },
      "defaultTile": {
        "type": "string",
        "minLength": 1
      },
      "overrides": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "x",
            "y",
            "tile"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "tile": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "chunkSizeTiles": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      }
    }
  }
}
