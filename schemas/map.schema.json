{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client map configuration",
  "type": "object",
  "required": ["kind", "id", "width", "height", "tileSize", "defaultTile", "overrides"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "map" },
    "id": { "type": "string", "minLength": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "tileSize": { "type": "integer", "minimum": 1 },
    "defaultTile": { "type": "string", "minLength": 1 },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["x", "y", "tile"],
        "additionalProperties": false,
        "properties": {
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "tile": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
