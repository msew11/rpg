{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bagColumns",
    "bagRows",
    "initialMapId",
    "attackTimings"
  ],
  "properties": {
    "bagColumns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "bagRows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "initialMapId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "attackTimings": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gender",
          "motion",
          "sourceDurationMs",
          "hitRatio"
        ],
        "properties": {
          "gender": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "motion": {
            "type": "integer",
            "enum": [
              4,
              5,
              6
            ]
          },
          "sourceDurationMs": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "hitRatio": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          }
        }
      }
    }
  }
}
