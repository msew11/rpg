{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Equipment configuration",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "appearanceId",
      "baseDamageMin",
      "baseDamageMax",
      "baseAttackRange",
      "baseAttackSpeed"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      },
      "appearanceId": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      },
      "baseDamageMin": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000000
      },
      "baseDamageMax": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000000
      },
      "baseAttackRange": {
        "type": "number",
        "minimum": 0,
        "maximum": 10000
      },
      "baseAttackSpeed": {
        "type": "number",
        "minimum": 0,
        "maximum": 20
      }
    }
  }
}
