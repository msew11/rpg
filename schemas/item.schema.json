{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client item configuration",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "category",
      "subCategory",
      "relatedId",
      "maxStack"
    ],
    "additionalProperties": false,
    "properties": {
      "relatedId": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
      "iconAssetId": { "type": "string" },
      "groundAssetId": { "type": "string" },
      "name": { "type": "string", "minLength": 1 },
      "id": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      },
      "category": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "subCategory": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "maxStack": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      }
    }
  }
}
