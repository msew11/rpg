<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.1" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ClientTests" />
    <Compile Remove="tests/ClientTests/**/*.cs" />
    <Compile Remove="src/Protocol/Generated/**/*.cs" />
    <Compile Remove="src/Server/ActorProtocol/Generated/**/*.cs" />
    <Protobuf Include="proto/**/*.proto" Exclude="proto/actor/**/*.proto" ProtoRoot="proto" OutputDir="src\Protocol\Generated" GrpcServices="None" />
    <Protobuf Include="proto/actor/**/*.proto" ProtoRoot="proto" OutputDir="src\Server\ActorProtocol\Generated" GrpcServices="None" />
  </ItemGroup>
</Project>
