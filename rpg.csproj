<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.1" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ClientTests" />
    <Compile Remove="tests/ClientTests/**/*.cs" />
    <Compile Remove="src/Net/Message/**/*.cs" />
    <Compile Remove="src/ProtocolV2/Generated/**/*.cs" />
    <Compile Remove="src/ServerV2/ActorProtocol/Generated/**/*.cs" />
    <Protobuf Include="proto/**/*.proto" ProtoRoot="proto" OutputDir="src\Net\Message" GrpcServices="None" />
    <Protobuf Include="protov2/**/*.proto" Exclude="protov2/actor/**/*.proto" ProtoRoot="protov2" OutputDir="src\ProtocolV2\Generated" GrpcServices="None" />
    <Protobuf Include="protov2/actor/**/*.proto" ProtoRoot="protov2/actor" OutputDir="src\ServerV2\ActorProtocol\Generated" GrpcServices="None" />
  </ItemGroup>
</Project>
